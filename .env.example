# Luma Monitor Frontend Environment Variables

# The base URL of your deployed Python FastAPI backend (e.g. on Render, Railway, Fly.io, or your Mac)
# Example: https://my-luma-backend.onrender.com or http://192.168.1.50:8000
VITE_BACKEND_URL=

# Optional: The WebSocket signaling URL if different from VITE_BACKEND_URL
# Example: wss://my-luma-backend.onrender.com/ws
VITE_WS_URL=

# Port for local dev server
PORT=3000
